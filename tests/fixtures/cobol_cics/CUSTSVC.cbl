       IDENTIFICATION DIVISION.
       PROGRAM-ID. CUSTSVC.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CUSTCPY.
       COPY DCLCUST.
       PROCEDURE DIVISION.
           EXEC SQL
                SELECT NAME INTO :WS-NAME FROM CUSTOMER
                WHERE CUSTNO = :WS-CUSTNO
           END-EXEC.
