//NIGHTLY  JOB (ACCT),'NIGHTLY BATCH',CLASS=A
//EXTRACT  EXEC PGM=EXTRACT
//INPUT    DD DSN=CUST.MASTER,DISP=SHR
//OUTPUT   DD DSN=EXTRACT.OUT,DISP=(NEW,CATLG)
//TRANS    EXEC PGM=TRANSFRM
//INDD     DD DSN=EXTRACT.OUT,DISP=SHR
//OUTDD    DD DSN=TRANS.OUT,DISP=(NEW,CATLG)
//LOAD     EXEC PGM=LOADDB
//INDD     DD DSN=TRANS.OUT,DISP=SHR
